<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.example.PostController"
         tabClosingPolicy="UNAVAILABLE"
         stylesheets="@style.css">

    <!-- Feed -->
    <Tab text="Feed">
        <VBox styleClass="page">

            <Label text="Feed" styleClass="page-title"/>
            <Label text="Create a post and add comments below." styleClass="page-subtitle"/>

            <VBox styleClass="form-block">
                <Label text="Post" styleClass="field-label"/>
                <HBox styleClass="form-row">
                    <TextField fx:id="postInput"
                               promptText="Write a post..."
                               styleClass="input-field"/>
                    <Button fx:id="postButton"
                            text="Add Post"
                            styleClass="button-primary"
                            onAction="#addPost"/>
                </HBox>
            </VBox>

            <VBox styleClass="form-block">
                <Label text="Comment" styleClass="field-label"/>
                <HBox styleClass="form-row">
                    <TextField fx:id="commentInput"
                               promptText="Write a comment..."
                               styleClass="input-field"/>
                    <Button fx:id="commentButton"
                            text="Add Comment"
                            styleClass="button-primary"
                            onAction="#addComment"/>
                </HBox>
            </VBox>

            <VBox styleClass="content-panel" spacing="10" alignment="CENTER">
                <Label text="Current post" styleClass="field-label"/>
                <Accordion fx:id="feedAccordion" prefWidth="420" maxWidth="420"/>
                <Button fx:id="deletePostButton"
                        text="Delete Post"
                        styleClass="button-secondary"
                        onAction="#deletePost"/>
            </VBox>

        </VBox>
    </Tab>

    <!-- Comments -->
    <Tab text="Comments">
        <VBox styleClass="page">

            <Label text="Comments" styleClass="page-title"/>
            <Label text="All comments linked to the current post." styleClass="page-subtitle"/>

            <ScrollPane fitToWidth="true"
                        prefWidth="420"
                        maxWidth="420"
                        prefHeight="420"
                        hbarPolicy="NEVER">
                <VBox fx:id="commentsBox" spacing="10">
                    <padding>
                        <Insets top="4" right="4" bottom="4" left="4"/>
                    </padding>
                </VBox>
            </ScrollPane>

        </VBox>
    </Tab>

</TabPane>
