<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.example.PostController"
         tabClosingPolicy="UNAVAILABLE">

    <Tab text="Feed">
        <VBox alignment="CENTER" spacing="16">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <Label text="Feed" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox alignment="CENTER" spacing="8">
                <TextField fx:id="postInput" promptText="Write a post..." prefWidth="280"/>
                <Button fx:id="postButton" text="Add Post" onAction="#addPost"/>
            </HBox>

            <HBox alignment="CENTER" spacing="8">
                <TextField fx:id="commentInput" promptText="Write a comment..." prefWidth="280"/>
                <Button fx:id="commentButton" text="Add Comment" onAction="#addComment"/>
            </HBox>

            <Accordion fx:id="feedAccordion" prefWidth="400"/>

            <Button fx:id="deletePostButton" text="Delete Post" onAction="#deletePost"/>
        </VBox>
    </Tab>

    <Tab text="Comments">
        <VBox spacing="12">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <Label text="here are all comments" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="commentsBox" spacing="8">
                    <padding>
                        <Insets top="8" right="8" bottom="8" left="8"/>
                    </padding>
                </VBox>
            </ScrollPane>
        </VBox>
    </Tab>

</TabPane>
